DATABASE_URL=postgres://...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# AWS Secrets Manager: source of truth for rotated keys. Configure the region /
# secret and give the host AWS access (explicit keys or an IAM role).
AWS_REGION=eu-west-2
AWS_SECRET_NAME=aqua_backend
# Fail-closed: refuse to start if the secret can't be read, so the app never runs
# on stale/fallback values. Any AWS outage means downtime until it can be read.
AWS_SECRETS_REQUIRED=true
SUPERADMIN_EMAILS=steven@humara.io,ben@humara.io

# Bridge to the main AquaAI backend's admin API. REQUIRED by three sections of
# this portal — without both values they render a "Backend bridge is not
# configured" notice and show no data:
#   * Feature D (breeder verifications / disputes / delivery)
#   * Content Moderation (the Apple Guideline 1.2 report queue and user blocks)
#   * App Analytics (Users / Consultants / Breeders, incl. per-account drill-down)
# The token must belong to a backend account with is_staff/admin rights, since
# every endpoint behind it is guarded by user_auth.permissions.IsAdmin.
AQUAAI_BACKEND_API_URL=https://api.aquaai.uk
AQUAAI_BACKEND_API_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
LEGACY_ADMIN_REDIRECT_URL=https://admin-control.aquaai.uk
LEGACY_ADMIN_INTERNAL_PATH=/django-internal-admin-8x7k/

# DSAR identity verification: requester logs in here; the admin portal detects
# the login via the shared django_session table (see docs/DSAR_LOGIN_VERIFICATION.md)
PLATFORM_LOGIN_URL=https://aquaai.uk/login

# Auto-refresh the mailbox + process DSARs from inside the web app (works on any
# host, no separate worker/cron). Set to false only if you run the dedicated
# `run_automation` worker instead.
INBOX_AUTOREFRESH=true
INBOX_AUTOREFRESH_INTERVAL=120

# Google Workspace OAuth inbox / send flow
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=support@aquaai.uk
SUPPORT_ALIAS_EMAIL=support@aquaai.uk

# Provider approval / rejection emails.
# EMAIL_LOGO_URL must be an absolute https URL to a PNG or JPG anyone can open
# (not a relative path, not /static/, not an SVG — those are what break the
# banner image). Leave it blank and the emails simply omit the logo image.
EMAIL_LOGO_URL=https://aquaai.uk/email/aqua-ai-logo.png
PRIVACY_POLICY_URL=https://aquaai.uk/privacy
TERMS_URL=https://aquaai.uk/terms
# Where a provider's reply lands. Blank = the support address shown in the body.
PROVIDER_EMAIL_REPLY_TO=
PRIVACY_ALIAS_EMAIL=privacy@aquaai.uk
PROVIDERS_ALIAS_EMAIL=providers@aquaai.uk

# Optional SMTP / IMAP fallback
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Aqua AI Admin <support@aquaai.uk>
